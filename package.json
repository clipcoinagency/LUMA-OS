{
  "name": "life-os",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Life OS V1 — local-first personal productivity app (shared web core + platform packaging).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-singlefile.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/file-launch.mjs && node tests/e2e/dashboard.mjs",
    "icons": "node scripts/make-icons.mjs",
    "package:browser": "node scripts/package-browser-edition.mjs",
    "poc:validate": "node poc/tests/validate.mjs",
    "poc:serve": "node poc/tests/serve.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@lucide/svelte": "^1.48.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "fake-indexeddb": "^6.2.5",
    "playwright": "1.63.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
